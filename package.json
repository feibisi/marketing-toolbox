{
    "name": "modiqi-marketing-toolbox",
    "version": "2.4.0",
    "description": "Modiqi 数字营销工作台 - 设计系统与工具集",
    "scripts": {
        "manifest:write": "python3 scripts/sync_tool_manifest.py --write",
        "check:manifest": "python3 scripts/sync_tool_manifest.py",
        "marketing-catalog:write": "python3 scripts/sync_marketing_catalog.py --write",
        "check:marketing-catalog": "python3 scripts/sync_marketing_catalog.py && python3 tests/marketing_catalog_audit.py",
        "test:static": "python3 tests/static_audit.py",
        "test:js": "python3 tests/js_syntax.py",
        "test:runtime": "playwright test",
        "test:quality": "npm run check:manifest && npm run check:workflows && npm run check:core && npm run check:project-schema && npm run check:marketing-catalog && npm run check:vendor && npm run check:a11y-normalized && npm run test:js && npm run test:static && npm run lint:css && npm run test:runtime && npm run check:layout",
        "lint:css": "stylelint '**/*.css' --ignore-path .gitignore",
        "lint:css:fix": "stylelint '**/*.css' --fix --ignore-path .gitignore",
        "check:colors": "grep -rE '#[0-9a-fA-F]{3,6}' --include='*.css' . | grep -v node_modules | grep -v '.stylelintrc'",
        "check:radius": "grep -r 'border-radius' --include='*.css' . | grep -v node_modules",
        "check:transition": "grep -r 'transition:' --include='*.css' . | grep -v node_modules",
        "vendor:write": "python3 scripts/sync_vendor_assets.py --write",
        "check:vendor": "python3 scripts/sync_vendor_assets.py",
        "check:workflows": "python3 tests/workflow_audit.py",
        "core:write": "python3 scripts/sync_core_readiness.py --write",
        "check:core": "python3 scripts/sync_core_readiness.py",
        "check:project-schema": "python3 tests/project_schema_audit.py",
        "check:release-readiness": "python3 scripts/sync_core_readiness.py --require-release",
        "check:a11y-normalized": "python3 scripts/normalize_html_accessibility.py",
        "audit:layout": "node scripts/audit_visual_layout.js",
        "check:layout": "npm run audit:layout && node scripts/audit_visual_layout.js --check"
    },
    "devDependencies": {
        "@playwright/test": "1.62.1",
        "html2canvas": "1.4.1",
        "lucide": "0.468.0",
        "sortablejs": "1.15.6",
        "stylelint": "16.26.1",
        "stylelint-config-standard": "36.0.1",
        "stylelint-declaration-strict-value": "1.10.11"
    },
    "keywords": [
        "digital-marketing",
        "design-system",
        "strategy-tools",
        "modiqi"
    ],
    "author": "Modiqi Design System Team",
    "license": "MIT"
}
