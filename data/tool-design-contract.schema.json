{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "tools"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "kind", "migration_status"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "pattern": "^[^/]+-toolkit/[^/]+\\.html$" },
          "kind": { "enum": ["fixed-canvas", "worksheet", "calculator", "report", "legacy-unclassified"] },
          "migration_status": { "enum": ["declared", "legacy-unclassified", "verified"] },
          "paper": { "enum": ["a3-landscape", "a4-portrait", "none"] },
          "output": { "enum": ["single-sheet", "multi-page", "result-summary", "undecided"] }
        }
      }
    }
  }
}
