{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modiqi.com/schemas/project-context-v2.json",
  "title": "Modiqi project context",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "stage", "evidence", "createdAt", "updatedAt"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "id": { "type": "string", "minLength": 1, "maxLength": 120 },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "owner": { "type": "string", "maxLength": 120 },
    "brand": { "type": "string", "maxLength": 120 },
    "objective": { "type": "string", "maxLength": 240 },
    "constraints": { "type": "string", "maxLength": 2000 },
    "stage": { "enum": ["discovery", "strategy", "execution", "measurement"] },
    "targetDate": { "type": "string", "pattern": "^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "kind", "source", "owner", "reviewDate", "status", "toolPath", "fieldKey", "createdAt", "updatedAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 120 },
        "statement": { "type": "string", "minLength": 1, "maxLength": 500 },
        "kind": { "enum": ["fact", "assumption", "to_verify"] },
        "source": { "type": "string", "minLength": 1, "maxLength": 500 },
        "owner": { "type": "string", "maxLength": 120 },
        "reviewDate": { "type": "string", "pattern": "^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "status": { "enum": ["draft", "confirmed", "rejected", "needs_review"] },
        "toolPath": { "type": "string", "maxLength": 240 },
        "fieldKey": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
